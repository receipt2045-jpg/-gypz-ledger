# 보안 헤더 — netlify.toml의 [[headers]]와 같은 내용을 Cloudflare Pages 형식으로.
# frame-ancestors/X-Frame-Options: 다른 사이트가 앱을 투명 iframe으로 덮어
#   '회원 탈퇴' 같은 버튼을 대신 누르게 하는 클릭재킹을 막는다.
# connect-src: 실제로 호출하는 곳만 허용 (Supabase, 환율 API).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; font-src 'self' data: https://cdn.jsdelivr.net; img-src 'self' data: blob:; connect-src 'self' https://sygmpteafxlrhfbipkep.supabase.co wss://sygmpteafxlrhfbipkep.supabase.co https://api.frankfurter.dev; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: geolocation=(), camera=(), payment=()
